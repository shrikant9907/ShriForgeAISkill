{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shriforgeaiskill:schema:project-truth:v1",
  "title": "ShriForgeAISkill Project Truth",
  "type": "object",
  "required": [
    "version",
    "facts",
    "requirements",
    "rules",
    "decisions",
    "assumptions",
    "unknowns"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "facts": {
      "type": "array"
    },
    "requirements": {
      "type": "array"
    },
    "rules": {
      "type": "array"
    },
    "decisions": {
      "type": "array"
    },
    "assumptions": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
