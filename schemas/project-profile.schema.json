{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shriforgeaiskill:schema:project-profile:v1",
  "title": "ShriForgeAISkill Project Profile",
  "type": "object",
  "required": [
    "version",
    "project",
    "audiences",
    "primary_intents"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "market": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_intents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technology": {
      "type": "object"
    },
    "constraints": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
